# Beispielwerte, keine Secrets. Kopieren nach .env (nicht einchecken).
FAMKO_TAG=dev
FAMKO_DOMAIN=famko.example.org
FAMKO_ALLOWED_HOSTS=famko.example.org
FAMKO_CSRF_TRUSTED_ORIGINS=https://famko.example.org
# Optional; sonst erzeugt der Entrypoint /data/secrets/django_secret_key
# FAMKO_SECRET_KEY=
# Heimnetz-CIDR (für VM-Firewall/NPM-Hinweise, siehe Runbook)
FAMKO_HEIMNETZ_CIDR=192.168.0.0/24
# Backup-Ordner auf dem Host
FAMKO_BACKUP_DIR=/srv/famko/backup
# Bind-IP für web (nur LAN-IP der VM)
FAMKO_BIND_IP=127.0.0.1
