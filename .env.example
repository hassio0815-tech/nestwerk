# FamKo: Konfigurationsvorlage. Keine Geheimnisse, nur Platzhalter.
# Kopieren nach .env und Werte anpassen. Die .env niemals ins Repository einchecken.
# Der Installer deploy/install.sh schreibt die meisten Werte selbst (siehe docs/INSTALLATION.md).

# Image-Tag, den docker compose baut und startet (Updates setzen ihn auf den Commit-Stand).
FAMKO_TAG=dev

# Domain, unter der FamKo über den Reverse Proxy erreichbar ist (ohne https://).
FAMKO_DOMAIN=famko.example.org

# Erlaubte Host-Namen für Django, kommagetrennt. Exakter Name oder Suffix mit führendem Punkt (.example.org).
FAMKO_ALLOWED_HOSTS=famko.example.org

# Vertrauenswürdige Ursprünge für Formulare (CSRF), mit Schema, kommagetrennt.
FAMKO_CSRF_TRUSTED_ORIGINS=https://famko.example.org

# Öffentliche Basis-URL für Links in Benachrichtigungen. Bis die Domain steht: http://<VM-IP>:8000
FAMKO_BASIS_URL=https://famko.example.org

# Einmaliges Token für den Einrichtungs-Assistenten (/einrichtung/). Der Installer erzeugt es.
# Nach Abschluss der Einrichtung aus der .env entfernen und docker compose up -d ausführen.
# FAMKO_SETUP_TOKEN=<vom-installer-erzeugt>

# Django-Geheimschlüssel. Optional; sonst erzeugt der Entrypoint /data/secrets/django_secret_key.
# FAMKO_SECRET_KEY=<langer-zufaelliger-wert>

# Schlüssel für das verschlüsselte SMTP-Passwort (Fernet). Optional; sonst liegt er unter /data/secrets/fernet.key.
# FAMKO_FERNET_KEY=<fernet-schluessel>

# Kontaktadresse für Web-Push (VAPID, mailto: oder https:). Optional.
# FAMKO_VAPID_KONTAKT=mailto:eltern@example.org

# Heimnetz in CIDR-Schreibweise. Nur ein Hinweis für Firewall und Proxy-Konfiguration.
FAMKO_HEIMNETZ_CIDR=192.168.0.0/24

# Zusätzliche private Ziele, die die Container erreichen dürfen, kommagetrennt (z. B. ein SMTP-Relay im LAN).
# FAMKO_EGRESS_ERLAUBT=<LAN-IP-des-SMTP-Relays>

# Backup-Ordner auf dem Host. Muss UID 1000 gehören. Wird im Container als /backup eingebunden.
FAMKO_BACKUP_DIR=/srv/famko/backup

# Aufbewahrung der Datenbank-Backups (optional, Standardwerte in Klammern).
# FAMKO_BACKUP_TAEGLICH=14        # tägliche Dumps (14)
# FAMKO_BACKUP_WOECHENTLICH=8     # wöchentliche Dumps (8)
# FAMKO_BACKUP_MONATLICH=12       # monatliche Dumps (12)
# FAMKO_BACKUP_UPDATE_BEHALTEN=5  # Backups vor Updates (5)
# FAMKO_BACKUP_MAX_ALTER_STUNDEN=36  # Warnschwelle für den Backup-Test (36)

# Bind-IP für den Web-Dienst. Nur die LAN-IP der VM, nie eine öffentliche Adresse.
# 127.0.0.1 ist für die lokale Entwicklung gedacht.
FAMKO_BIND_IP=127.0.0.1
