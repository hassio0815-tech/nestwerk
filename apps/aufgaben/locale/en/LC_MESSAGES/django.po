msgstr "Please enter a short note."

#: anerkennung.py:82
#, python-format
msgid "Die Bemerkung ist zu lang (höchstens %(n)s Zeichen)."
msgstr "The note is too long (at most %(n)s characters)."

#: anerkennung.py:86
#, python-format
msgid "Bitte 1 bis %(max)s Punkte eingeben."
msgstr "Please enter 1 to %(max)s points."

#: anerkennung.py:99
#, python-format
msgid ""
"Diese Woche sind für %(name)s nur noch %(rest)s Anerkennungs-Punkte möglich."
msgstr ""
"This week only %(rest)s more recognition points are possible for %(name)s."

