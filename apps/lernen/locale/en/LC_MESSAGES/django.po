msgstr "All children"

#: templates/lernen/eltern.html:42
msgid "Von"
msgstr "From"

#: templates/lernen/eltern.html:43
msgid "Bis"
msgstr "To"

#: templates/lernen/eltern.html:44
msgid "Grund"
msgstr "Reason"

#: templates/lernen/eltern.html:46
msgid "Pause eintragen"
msgstr "Add rest days"

#: templates/lernen/eltern.html:51
msgid "offen"
msgstr "open"

#: templates/lernen/eltern.html:52
msgid "Löschen"
msgstr "Delete"

#: templates/lernen/eltern.html:54
