msgstr "Today %(minuten)s of %(ziel)s minutes."

#: templates/lernen/eltern.html:20
#, python-format
msgid "Serie: %(wochen)s Woche."
msgid_plural "Serie: %(wochen)s Wochen."
msgstr[0] "Streak: %(wochen)s week."
msgstr[1] "Streak: %(wochen)s weeks."

#: templates/lernen/eltern.html:21
#, python-format
msgid "Geübte Tage diese Woche: %(tage)s."
msgstr "Days practised this week: %(tage)s."

#: templates/lernen/eltern.html:22
#, python-format
msgid "Vorschlag an das Kind: Tagesziel auf %(minuten)s Minuten erhöhen."
msgstr "Suggestion to the child: raise the daily goal to %(minuten)s minutes."

#: templates/lernen/eltern.html:24
msgid "Noch keine Kinder."
msgstr "No children yet."

#: templates/lernen/eltern.html:35
msgid "Schonung (Krankheit, Ferien)"
msgstr "Rest days (illness, holidays)"

#: templates/lernen/eltern.html:36
msgid ""
"An Pausentagen wird kein Ziel verlangt und die Serie bleibt erhalten. Ferien "
"für alle schaltet ihr in den Einstellungen ein."
msgstr ""
"On rest days no goal is expected and the streak is kept. You can turn on "
"holidays for everyone in the settings."

#: templates/lernen/eltern.html:38
msgid "Einstellungen"
msgstr "Settings"

#: templates/lernen/eltern.html:40
msgid "Für wen"
msgstr "For whom"

#: templates/lernen/eltern.html:41 templates/lernen/eltern.html:51
