#!/usr/sbin/nft -f
# FamKo: Port 8000 (web) nur vom Nginx Proxy Manager. Platzhalter @NPM_IP@ setzt install.sh.
# Eigene Tabelle (Priorität -10) greift VOR den Docker-Regeln; Docker-Port-Veröffentlichung
# umgeht sonst ufw/INPUT-Regeln. Idempotent: Tabelle wird neu aufgebaut.
table inet famko_fw
delete table inet famko_fw
table inet famko_fw {
    chain eingang {
        type filter hook input priority -10; policy accept;
        iifname "lo" accept
        tcp dport 8000 ip saddr @NPM_IP@ accept
        tcp dport 8000 drop
    }
    chain weiterleitung {
        type filter hook forward priority -10; policy accept;
        # veröffentlichter Port nach DNAT (Ziel-Container): ursprünglicher Zielport 8000
        ct status dnat ct original proto-dst 8000 ip saddr @NPM_IP@ accept
        ct status dnat ct original proto-dst 8000 drop
    }
}
